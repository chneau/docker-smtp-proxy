{
	"name": "docker-smtp-proxy",
	"module": "index.ts",
	"type": "module",
	"scripts": {
		"start": "bun index.ts",
		"dev": "bun --watch index.ts",
		"build": "bun build index.ts --target=bun --outdir=dist",
		"openapi": "API_KEY=generator bun -e 'import app from \"./index.ts\"; const r = await app.request(\"/doc\"); const j = await r.json(); await Bun.write(\"openapi.json\", JSON.stringify(j, null, 2) + \"\\n\");'",
		"upgrade": "bun update --latest",
		"lint": "tsc --noEmit",
		"check": "bun run --sequential --no-exit-on-error check:clean check:deno check:oxlint check:biome check:export lint",
		"publish": "docker build --pull --push --tag ghcr.io/chneau/smtp-proxy .",
		"all": "bun run --sequential --no-exit-on-error upgrade check openapi",
		"check:clean": "rm -rf dist out build",
		"check:deno": "deno fmt --use-tabs --quiet",
		"check:oxlint": "oxlint --fix-dangerously --fix-suggestions --fix --quiet",
		"check:biome": "timeout 3s biome check --write --unsafe .",
		"check:export": "ts-unused-exports tsconfig.json --excludePathsFromReport=index.ts"
	},
	"dependencies": {
		"@hono/standard-validator": "^0.4.0",
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-validator": "^0.9.1",
		"@scalar/hono-api-reference": "^0.12.0",
		"hono": "^4.13.5",
		"hono-openapi": "^1.3.1",
		"nodemailer": "^9.1.1",
		"zod": "^4.5.4",
		"zod-openapi": "^6.0.2"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@types/nodemailer": "^8.0.1",
		"typescript": "^7.0.2"
	}
}
